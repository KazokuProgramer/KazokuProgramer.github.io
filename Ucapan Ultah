<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffe4ef">
  <title>Happy Birthday, Sayang! 💗</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');

    :root {
      --pink: #f48caf;
      --deep: #a83d69;
      --ink: #63364c;
      --cream: #fff8fb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; overflow-x: hidden;
      font-family: 'DM Sans', sans-serif; color: var(--ink);
      background: radial-gradient(circle at 15% 15%, #fff 0 8%, transparent 30%),
                  linear-gradient(135deg, #ffe8f0, #f8d8e9 48%, #eee1ff);
    }
    .hearts { position: fixed; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
    .heart {
      position: absolute; bottom: -40px; color: #e879a3; opacity: .45;
      animation: floatUp linear infinite;
    }
    @keyframes floatUp {
      from { transform: translateY(0) rotate(0deg); opacity: 0; }
      15% { opacity: .5; }
      to { transform: translateY(-115vh) rotate(35deg); opacity: 0; }
    }
    main { position: relative; z-index: 1; width: min(920px, 92%); margin: auto; padding: 38px 0 55px; }
    .topline { text-align: center; color: var(--deep); letter-spacing: 3px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
    .card {
      margin: 22px auto 0; padding: clamp(26px, 6vw, 58px);
      background: rgba(255,255,255,.76); border: 1px solid rgba(255,255,255,.9);
      border-radius: 30px; box-shadow: 0 22px 70px rgba(142, 65, 105, .14);
      text-align: center; backdrop-filter: blur(10px);
    }
    .flower { font-size: 42px; margin-bottom: 10px; }
    h1 { font: 700 clamp(38px, 8vw, 72px)/1.08 'Playfair Display', serif; color: var(--deep); margin: 10px 0; }
    .name { color: #d65e91; }
    .subtitle { font-size: 16px; line-height: 1.8; max-width: 570px; margin: 18px auto 26px; color: #80566a; }
    .photo-frame {
      width: min(100%, 330px); aspect-ratio: 4/3; margin: 0 auto 26px;
      border: 8px solid white; border-radius: 22px; overflow: hidden;
      box-shadow: 0 12px 30px #c77d9b35; background: linear-gradient(135deg,#ffd8e7,#eadcff);
      display: grid; place-items: center; color: #a45b7b; font-size: 14px;
    }
    .photo-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .photo-placeholder { padding: 20px; line-height: 1.7; }
    .buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 24px; }
    button {
      border: 0; border-radius: 999px; padding: 14px 23px; cursor: pointer;
      font: 700 14px 'DM Sans', sans-serif; transition: transform .2s, box-shadow .2s;
    }
    button:hover { transform: translateY(-3px); box-shadow: 0 9px 20px #b64d7b30; }
    .primary { color: white; background: linear-gradient(135deg,#e879a3,#b84d7c); }
    .secondary { color: var(--deep); background: #ffe6ef; }
    .letter {
      display: none; max-width: 620px; margin: 28px auto 0; padding: 25px;
      text-align: left; background: #fff8fb; border: 1px dashed #e9a2bd; border-radius: 20px;
      line-height: 1.9; animation: appear .5s ease;
    }
    .letter.show { display: block; }
    @keyframes appear { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    .letter h2 { font: 600 25px 'Playfair Display',serif; color: var(--deep); text-align: center; }
    .signature { text-align: right; color: var(--deep); font-weight: 700; }
    .footer { text-align: center; margin-top: 25px; font-size: 12px; color: #98677e; }
    .burst { position: fixed; z-index: 5; pointer-events: none; font-size: 22px; animation: burst 1.6s ease-out forwards; }
    @keyframes burst { from { transform: translate(0,0) scale(.5); opacity: 1; } to { transform: translate(var(--x),var(--y)) rotate(160deg) scale(1.3); opacity: 0; } }
    @media (max-width: 520px) {
      main { padding-top: 25px; }
      .card { border-radius: 23px; }
      .subtitle { font-size: 14px; }
      button { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="hearts" id="hearts"></div>
  <main>
    <div class="topline">A little celebration for someone special</div>
    <section class="card">
      <div class="flower">🎀💗🎂</div>
      <div style="font-size:13px;letter-spacing:2px;color:#b36b88;font-weight:700">HARI SPESIALMU TELAH TIBA</div>
      <h1>Happy Birthday,<br><span class="name" id="nameHeading">Sayang</span>!</h1>
      <p class="subtitle">
        Hari ini dunia merayakan kehadiran seseorang yang begitu istimewa.
        Semoga setiap senyummu selalu punya alasan, dan setiap harapanmu menemukan jalannya.
      </p>

      <div class="photo-frame" id="photoFrame">
        <div class="photo-placeholder">📷<br>Tempat foto kalian berdua<br><small>Ganti dengan foto favoritmu</small></div>
      </div>

      <p class="subtitle" style="margin-bottom:8px">Untuk perempuan paling manis yang selalu punya tempat istimewa di hatiku. 💕</p>
      <div class="buttons">
        <button class="primary" onclick="toggleLetter()">💌 Buka surat kecil</button>
        <button class="secondary" onclick="surprise()">✨ Kirim kejutan</button>
        <button class="secondary" id="musicButton" onclick="toggleMusic()">♫ Putar musik</button>
      </div>

      <article class="letter" id="letter">
        <h2>Untuk Kamu, Sayangku 💗</h2>
        <p>Selamat ulang tahun, cintaku.</p>
        <p>
          Terima kasih sudah hadir dan membuat hari-hariku terasa lebih berwarna.
          Di hari istimewamu ini, aku berharap kamu selalu diberi kesehatan,
          kebahagiaan, kemudahan dalam setiap langkah, dan keberanian untuk meraih
          semua impianmu.
        </p>
        <p>
          Jangan pernah lupa betapa berharganya dirimu. Tetap jadi perempuan hebat
          dengan senyum indah yang selalu aku kagumi. Semoga aku masih bisa menemani
          banyak ulang tahunmu berikutnya, menciptakan cerita-cerita indah bersama.
        </p>
        <p>Aku sayang kamu, hari ini, esok, dan seterusnya. ❤️</p>
        <p class="signature">Dengan cinta,<br>Orang yang selalu menyayangimu</p>
      </article>
    </section>
    <div class="footer">Dibuat dengan sepenuh hati untuk seseorang yang istimewa ♥</div>
  </main>

  <audio id="music" loop>
    <!-- Tambahkan file musik milikmu, misalnya: <source src="musik.mp3" type="audio/mpeg"> -->
  </audio>

  <script>
    // UBAH NAMA PACAR DI SINI
    const namaPacar = "Atin";

    // OPSIONAL: masukkan nama file foto, misalnya "foto-kita.jpg"
    const fileFoto = "";

    document.getElementById("nameHeading").textContent = namaPacar;
    if (fileFoto.trim()) {
      document.getElementById("photoFrame").innerHTML = `<img src="${fileFoto}" alt="Foto kenangan kita">`;
    }

    // Membuat animasi hati melayang
    const hearts = document.getElementById("hearts");
    const symbols = ["♥", "♡", "💕", "💗"];
    for (let i = 0; i < 24; i++) {
      const heart = document.createElement("span");
      heart.className = "heart";
      heart.textContent = symbols[Math.floor(Math.random() * symbols.length)];
      heart.style.left = Math.random() * 100 + "%";
      heart.style.fontSize = (14 + Math.random() * 23) + "px";
      heart.style.animationDuration = (8 + Math.random() * 10) + "s";
      heart.style.animationDelay = (-Math.random() * 15) + "s";
      hearts.appendChild(heart);
    }

    function toggleLetter() {
      document.getElementById("letter").classList.toggle("show");
    }

    function surprise() {
      const emojis = ["💖", "💗", "💕", "✨", "🌸", "💝"];
      for (let i = 0; i < 34; i++) {
        const item = document.createElement("span");
        item.className = "burst";
        item.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        item.style.left = (window.innerWidth / 2) + "px";
        item.style.top = (window.innerHeight / 2) + "px";
        item.style.setProperty("--x", (Math.random() - .5) * window.innerWidth + "px");
        item.style.setProperty("--y", (Math.random() - .5) * window.innerHeight + "px");
        document.body.appendChild(item);
        setTimeout(() => item.remove(), 1700);
      }
    }

    function toggleMusic() {
      const audio = document.getElementById("music");
      const button = document.getElementById("musicButton");
      if (!audio.querySelector("source")) {
        alert("Tambahkan file musik terlebih dahulu. Lihat petunjuk di dalam kode pada bagian audio.");
        return;
      }
      if (audio.paused) {
        audio.play();
        button.textContent = "Ⅱ Jeda musik";
      } else {
        audio.pause();
        button.textContent = "♫ Putar musik";
      }
    }
  </script>
</body>
</html>
